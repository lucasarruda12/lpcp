evalComRetorno :: [Comando] -> EvalM ()
evalComRetorno (Retorno:cmds) = pure ()
evalComRetorno se@(SeCmd _ _):cmds = evalComRertorno se *> evalComRetorno cmds
evalComRetorno enquanto@(Enquanto _ _):cmds = evalComRertorno enquanto *> evalComRetorno cmds
evalComRetorno cmd:cmds = eval cmd *> evalComRetorno cmds
evalComRetorno [] = pure ()
