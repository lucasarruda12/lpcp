INICIALIZE x :: Int COM int(leia);
INICIALIZE i1 :: Int COM 0;
INICIALIZE i2 :: Int COM 0;
INICIALIZE i3 :: Int COM 0;
INICIALIZE i4 :: Int COM 0;

ENQUANTO:
  x > 0, FAÇA:
    SE:
      x <= 25, FAÇA:
        i1 = i1 + 1;
      FIM_FAÇA.
      
      x <= 50, FAÇA:
        i2 = i2 + 1;
      FIM_FAÇA.

      x <= 75, FAÇA:
        i3 = i3 + 1;
      FIM_FAÇA.

      x <= 100, FAÇA:
        i4 = i3 + 1;
      FIM_FAÇA.

      x > 100, FAÇA:
      FIM_FAÇA.
    FIM_SE.

    x = int(leia);
  FIM_FAÇA.
FIM_ENQUANTO.

IMPRIMA i1;
IMPRIMA i2;
IMPRIMA i3;
IMPRIMA i4;
