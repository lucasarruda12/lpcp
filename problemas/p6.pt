ENUM arvore:
  folha,
  galho((arvore, Int, arvore))
FIM_ENUM.

FUNCAO inserir(val :: Int, arv :: arvore) -> arvore:
  CASAMENTO arv:
    folha, FAÇA:
      RETORNE arvore::galho((arvore::folha, val, arvore::folha));
    FIM_FACA.
    galho(t), FAÇA:
      SE:
        val < t[1], FAÇA:
          RETORNE arvore::galho((inserir(val, t[0]), t[1], t[2]));
        FIM_FAÇA.
        val >= t[1], FAÇA:
          RETORNE arvore::galho((t[0], t[1], inserir(val, t[2])));
        FIM_FAÇA.
      FIM_SE.
    FIM_FAÇA.
  FIM_CASAMENTO.
FIM_FUNCAO.

INICIALIZE a :: arvore COM arvore::folha;
INICIALIZE a :: arvore COM inserir(5, a);
INICIALIZE a :: arvore COM inserir(3, a);
INICIALIZE a :: arvore COM inserir(7, a);
INICIALIZE a :: arvore COM inserir(1, a);
INICIALIZE a :: arvore COM inserir(9, a);
FUNCAO minimo(arv :: arvore, nivel :: Int) -> (Int, Int):
  CASAMENTO arv:
    folha, FAÇA:
      RETORNE (0, 0);
    FIM_FAÇA.
    galho(t), FAÇA:
      CASAMENTO t[0]:
        folha, FAÇA:
          RETORNE (t[1], nivel);
        FIM_FAÇA.
        galho(esq), FAÇA:
          RETORNE minimo(t[0], nivel + 1);
        FIM_FAÇA.
      FIM_CASAMENTO.
    FIM_FAÇA.
  FIM_CASAMENTO.
FIM_FUNCAO.

FUNCAO maximo(arv :: arvore, nivel :: Int) -> (Int, Int):
  CASAMENTO arv:
    folha, FAÇA:
      RETORNE (0, 0);
    FIM_FAÇA.
    galho(t), FAÇA:
      CASAMENTO t[2]:
        folha, FAÇA:
          RETORNE (t[1], nivel);
        FIM_FAÇA.
        galho(dir), FAÇA:
          RETORNE maximo(t[2], nivel + 1);
        FIM_FAÇA.
      FIM_CASAMENTO.
    FIM_FAÇA.
  FIM_CASAMENTO.
FIM_FUNCAO.

PROCEDIMENTO porNivel(fila :: [arvore], tamanho :: Int, proximo :: Int):
  SE:
    tamanho == 0, FAÇA:
      SE:
        vazio(fila), FAÇA:
          IMPRIMA "fim";
        FIM_FAÇA.
        NOT vazio(fila), FAÇA:
          IMPRIMA "---";
          porNivel(fila, proximo, 0);
        FIM_FAÇA.
      FIM_SE.
    FIM_FAÇA.
    tamanho > 0, FAÇA:
      CASAMENTO fila[0]:
        folha, FAÇA:
          porNivel(cauda(fila), tamanho - 1, proximo);
        FIM_FAÇA.
        galho(t), FAÇA:
          IMPRIMA t[1];
          DECLARE novaFila :: [arvore];
          novaFila = cauda(fila);
          DECLARE novoProximo :: Int;
          novoProximo = proximo;
          CASAMENTO t[0]:
            folha, FAÇA:
              INICIALIZE nada :: Int COM 0;
            FIM_FAÇA.
            galho(esq), FAÇA:
              novaFila = anexar(novaFila, t[0]);
              novoProximo = novoProximo + 1;
            FIM_FAÇA.
          FIM_CASAMENTO.
          CASAMENTO t[2]:
            folha, FAÇA:
              INICIALIZE nada :: Int COM 0;
            FIM_FAÇA.
            galho(dir), FAÇA:
              novaFila = anexar(novaFila, t[2]);
              novoProximo = novoProximo + 1;
            FIM_FAÇA.
          FIM_CASAMENTO.
          porNivel(novaFila, tamanho - 1, novoProximo);
        FIM_FAÇA.
      FIM_CASAMENTO.
    FIM_FAÇA.
  FIM_SE.
FIM_PROCEDIMENTO.

IMPRIMA a;
INICIALIZE m :: (Int, Int) COM minimo(a, 1);
INICIALIZE mx :: (Int, Int) COM maximo(a, 1);
IMPRIMA "Minimo: " + string(m[0]) + ", Nivel: " + string(m[1]);
IMPRIMA "Maximo: " + string(mx[0]) + ", Nivel: " + string(mx[1]);
INICIALIZE fila :: [arvore] COM [a];
porNivel([a], 1, 0);
