ENUM arvore:
  folha,
  galho((arvore, Int, arvore))
FIM_ENUM.

FUNCAO inserir(val :: Int, arv :: arvore) -> arvore:
  CASAMENTO arv:
    folha, FAÇA:
      RETORNE arvore::galho((arvore::folha, val, arvore::folha));
    FIM_FACA.
    galho(t), FAÇA:
      SE:
        val < t[1], FAÇA:
          RETORNE arvore::galho((inserir(val, t[0]), t[1], t[2]));
        FIM_FAÇA.
        val >= t[1], FAÇA:
          RETORNE arvore::galho((t[0], t[1], inserir(val, t[2])));
        FIM_FAÇA.
      FIM_SE.
    FIM_FAÇA.
  FIM_CASAMENTO.
FIM_FUNCAO.

INICIALIZE a :: arvore COM arvore::folha;
INICIALIZE a :: arvore COM inserir(5, a);
INICIALIZE a :: arvore COM inserir(3, a);
INICIALIZE a :: arvore COM inserir(7, a);
FUNCAO minimo(arv :: arvore, nivel :: Int) -> Int:
  CASAMENTO arv:
    folha, FAÇA:
      RETORNE 0;
    FIM_FACA.
    galho(t), FAÇA:
      CASAMENTO t[0]:
        folha, FAÇA:
          IMPRIMA t[1];
          IMPRIMA nivel;
          RETORNE t[1];
        FIM_FAÇA.
        galho(esq), FAÇA:
          RETORNE minimo(t[0], nivel + 1);
        FIM_FAÇA.
      FIM_CASAMENTO.
    FIM_FAÇA.
  FIM_CASAMENTO.
FIM_FUNCAO.
FUNCAO maximo(arv :: arvore, nivel :: Int) -> Int:
  CASAMENTO arv:
    folha, FAÇA:
      RETORNE 0;
    FIM_FAÇA.
    galho(t), FAÇA:
      CASAMENTO t[2]:
        folha, FAÇA:
          IMPRIMA t[1];
          IMPRIMA nivel;
          RETORNE t[1];
        FIM_FAÇA.
        galho(dir), FAÇA:
          RETORNE maximo(t[2], nivel + 1);
        FIM_FAÇA.
      FIM_CASAMENTO.
    FIM_FAÇA.
  FIM_CASAMENTO.
FIM_FUNCAO.
IMPRIMA a;
INICIALIZE m :: Int COM minimo(a, 1);
IMPRIMA m;
INICIALIZE mx :: Int COM maximo(a, 1);
IMPRIMA mx;