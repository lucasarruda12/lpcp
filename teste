FUNCAO obter_tamanho(l :: [Qualquer]) -> Int:
    INICIALIZE tamanho :: Int COM 0;
    ENQUANTO:
        NOT vazio(l), FAÇA:
            tamanho = tamanho + 1;
            l = cauda(l);
        FIM_FAÇA.
    FIM_ENQUANTO.
    RETORNE tamanho;
FIM_FUNCAO.

IMPRIMA (obter_tamanho([1,2,3,4,5,6]));

ENUM cor:
  verde,
  vermelho,
  amarelo
FIM_ENUM.

INICIALIZE x :: Qualquer COM 3;

x = cor::verde;

CASAMENTO x:
  verde, FAÇA:
    IMPRIMA x;
  FIM_FAÇA.
FIM_CASAMENTO.

